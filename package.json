{
  "name": "pendulo-formula-completa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulador didático da fórmula geral do período do pêndulo: regime simples e regime cicloidal a partir de uma única fórmula-motor.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/subir.mjs",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:single": "npm run typecheck && vite build --config vite.config.singlefile.ts && node scripts/gerar-arquivo-unico.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run tests/golden --passWithNoTests",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verificar": "npm run lint && npm run typecheck && npm run katex:verificar && npm run test:cobertura && npm run build && npm run build:single && npm run tamanho",
    "tamanho": "node scripts/verificar-tamanho.mjs",
    "test:cobertura": "vitest run --coverage",
    "tabelas": "node scripts/gerar-tabelas.mjs",
    "katex:enxugar": "node scripts/enxugar-katex.mjs",
    "katex:verificar": "node scripts/enxugar-katex.mjs --verificar",
    "validar:visual": "node scripts/validar-visual.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
